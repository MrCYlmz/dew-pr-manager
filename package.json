{
  "name": "dew-pr-manager",
  "version": "0.1.0",
  "description": "Local dashboard for your open GitHub PRs: status, owner, change sets and merge order. Bun + gh CLI, nothing to configure.",
  "license": "MIT",
  "author": "Celal Yilmaz",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrCYlmz/dew-pr-manager.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "bun": "latest"
  },
  "scripts": {
    "build": "bun build client/app.ts --target browser --outfile public/app.js",
    "dev": "bun run --parallel dev:client dev:server",
    "dev:client": "bun run build --watch",
    "dev:server": "bun --watch src/server.ts",
    "start": "bun run build && bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5"
  }
}
